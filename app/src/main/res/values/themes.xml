<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SmartElectricityPredictor" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.FirebaseUI.Base" parent="FirebaseUI">
        <item name="android:windowBackground">#FFFFFBFE</item>
        <item name="android:colorBackground">#FFFFFBFE</item>
        <item name="android:textColorPrimary">#FF1C1B1F</item>
        <item name="android:textColorSecondary">#FF49454F</item>
        <item name="colorPrimary">#FF6200EE</item>
        <item name="colorPrimaryDark">#FF3700B3</item>
        <item name="colorPrimaryVariant">#FF3700B3</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorSecondary">#FF625B71</item>
        <item name="colorSecondaryVariant">#FF4A4458</item>
        <item name="colorOnSecondary">#FFFFFFFF</item>
        <item name="colorOnBackground">#FF1C1B1F</item>
        <item name="colorSurface">#FFFFFBFE</item>
        <item name="colorOnSurface">#FF1C1B1F</item>
        <item name="colorError">#FFBA1A1A</item>
        <item name="colorOnError">#FFFFFFFF</item>
        <item name="android:colorAccent">#FF6200EE</item>
        <item name="android:statusBarColor">#FF3700B3</item>
        <item name="android:navigationBarColor">#FFFFFBFE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.FirebaseUI" parent="Theme.FirebaseUI.Base" />

    <style name="FirebaseUI.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:background">@drawable/firebaseui_action_button</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
</resources>
