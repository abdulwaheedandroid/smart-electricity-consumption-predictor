rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      function hasValidProfileFields() {
        return request.resource.data.keys().hasOnly([
          'uid',
          'fullName',
          'email',
          'age',
          'gender',
          'cellNumber',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'fullName',
          'email',
          'age',
          'gender',
          'cellNumber',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.age is int
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.gender is string
        && request.resource.data.cellNumber is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner() && hasValidProfileFields();
      allow update: if isOwner()
        && hasValidProfileFields()
        && request.resource.data.createdAt == resource.data.createdAt;

      match /historicalConsumption/{recordId} {
        function hasValidConsumptionFields() {
          let data = request.resource.data;
          let yearText = data.year < 10 ? '000' + string(data.year)
            : data.year < 100 ? '00' + string(data.year)
            : data.year < 1000 ? '0' + string(data.year)
            : string(data.year);
          let monthText = data.month < 10 ? '0' + string(data.month)
            : string(data.month);
          return data.keys().hasOnly([
            'month', 'year', 'unitsConsumed', 'billAmount',
            'createdAt', 'updatedAt', 'isDeleted'
          ])
          && data.keys().hasAll([
            'month', 'year', 'unitsConsumed', 'billAmount',
            'createdAt', 'updatedAt', 'isDeleted'
          ])
          && data.month is int && data.month >= 1 && data.month <= 12
          && data.year is int && data.year >= 1 && data.year <= 9999
          && recordId == yearText + '-' + monthText
          && (data.year < request.time.year()
            || (data.year == request.time.year()
              && data.month <= request.time.month()))
          && data.unitsConsumed is number && data.unitsConsumed >= 0
          // Infinity minus itself produces NaN; finite values produce zero.
          && !math.isNaN(data.unitsConsumed - data.unitsConsumed)
          && data.billAmount is number && data.billAmount >= 0
          && !math.isNaN(data.billAmount - data.billAmount)
          // The repository writes device timestamps as integer milliseconds.
          && data.createdAt is int && data.createdAt > 0
          && data.updatedAt is int && data.updatedAt >= data.createdAt
          && data.isDeleted is bool;
        }

        allow read: if isOwner();
        allow create: if isOwner() && hasValidConsumptionFields();
        allow update: if isOwner() && hasValidConsumptionFields()
          && request.resource.data.month == resource.data.month
          && request.resource.data.year == resource.data.year
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt >= resource.data.updatedAt;
        // Deletes synchronize as isDeleted=true, retaining the remote tombstone.
        allow delete: if false;
      }

      match /appliances/{applianceId} {
        function hasValidApplianceFields() {
          return request.resource.data.keys().hasOnly([
            'name',
            'powerWatts',
            'dailyUsageHours',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'name',
            'powerWatts',
            'dailyUsageHours',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.powerWatts is int
          && request.resource.data.powerWatts >= 1
          && request.resource.data.powerWatts <= 100000
          && request.resource.data.dailyUsageHours is number
          && request.resource.data.dailyUsageHours >= 0
          && request.resource.data.dailyUsageHours <= 24
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        }

        allow read, delete: if isOwner();
        allow create: if isOwner() && hasValidApplianceFields();
        allow update: if isOwner()
          && hasValidApplianceFields()
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
